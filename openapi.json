{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter API",
    "description": "\nClean read API over the legacy **Urja Meter Ops** portal. Data is synced into a local SQLite index\n(see `/v1/sync/status` for freshness) so consumers never touch the portal.\n\nAuth: send `X-API-Key`. Roles: `reader` (all GETs) and `admin` (also `POST /v1/sync`).\nResponses carry an `ETag` that changes only when a sync completes; send `If-None-Match` to get `304`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness + data freshness (no auth)",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
